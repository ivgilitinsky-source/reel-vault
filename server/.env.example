PORT=4000

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/reel_vault
# Установите true, если хостинг требует SSL-подключение к базе (например Render/Heroku)
DATABASE_SSL=false

# Длинная случайная строка для подписи JWT-токенов
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Адрес фронтенда, разрешённый для CORS
CLIENT_ORIGIN=http://localhost:5173
